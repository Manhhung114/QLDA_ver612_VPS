[Unit]
Description=QLDA V7.6 FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qlda
Group=qlda
WorkingDirectory=/opt/qlda/app
EnvironmentFile=/opt/qlda/shared/qlda.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/qlda/app/src
Environment=HOME=/opt/qlda/shared
Environment=QLDA_SETTINGS_DIR=/opt/qlda/shared/config
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
ExecStart=/opt/qlda/venv/bin/python -m uvicorn qlda.presentation.api.app:app --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/qlda /var/log/qlda
MemoryHigh=1200M
MemoryMax=1800M
TasksMax=128

[Install]
WantedBy=multi-user.target
