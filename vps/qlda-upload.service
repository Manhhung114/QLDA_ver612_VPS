[Unit]
Description=QLDA V6.22 Local File Upload Service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=qlda
Group=qlda
WorkingDirectory=/opt/qlda/app
EnvironmentFile=/opt/qlda/shared/qlda.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# ProtectHome=true intentionally hides /home/qlda. Point HOME/settings at the
# shared writable tree so settings_store never probes the protected legacy home.
Environment=HOME=/opt/qlda/shared
Environment=QLDA_SETTINGS_DIR=/opt/qlda/shared/config
ExecStart=/opt/qlda/venv/bin/python /opt/qlda/app/local_file_server_single_session_v622.py --host 127.0.0.1 --port 8502
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Admin may choose another data/trash folder, but system_settings_v622 restricts
# it to /opt/qlda. Keep the whole QLDA tree writable for those approved paths.
ReadWritePaths=/opt/qlda /var/log/qlda

[Install]
WantedBy=multi-user.target
