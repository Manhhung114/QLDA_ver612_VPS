[Unit]
Description=QLDA V7.6 Local File Upload + Excel Queue Service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=qlda
Group=qlda
WorkingDirectory=/opt/qlda/app
EnvironmentFile=/opt/qlda/shared/qlda.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/qlda/app/src
Environment=HOME=/opt/qlda/shared
Environment=QLDA_SETTINGS_DIR=/opt/qlda/shared/config
ExecStart=/opt/qlda/venv/bin/python -m qlda.presentation.upload_server --host 127.0.0.1 --port 8502
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/qlda /var/log/qlda

[Install]
WantedBy=multi-user.target
