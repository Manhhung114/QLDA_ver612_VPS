[Unit]
Description=QLDA V6.22 Local File Upload Service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=qlda
Group=qlda
WorkingDirectory=/opt/qlda/app
EnvironmentFile=/opt/qlda/shared/qlda.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/qlda/venv/bin/python /opt/qlda/app/local_file_server_v622.py --host 127.0.0.1 --port 8502
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/qlda/data /var/log/qlda

[Install]
WantedBy=multi-user.target
