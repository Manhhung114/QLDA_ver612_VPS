[Unit]
Description=QLDA V6.22 Streamlit VPS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qlda
Group=qlda
WorkingDirectory=/opt/qlda/app
EnvironmentFile=/opt/qlda/shared/qlda.env
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
ExecStart=/opt/qlda/venv/bin/streamlit run /opt/qlda/app/streamlit_app.py --server.address=127.0.0.1 --server.port=8501 --server.headless=true --browser.gatherUsageStats=false
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/qlda /var/log/qlda

[Install]
WantedBy=multi-user.target
