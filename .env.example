# Copy to /opt/qlda/shared/qlda.env on the VPS.
# NEVER commit real credentials to GitHub.

# -----------------------------------------------------------------------------
# LIVE data on the VPS (recommended/default)
# -----------------------------------------------------------------------------
# PostgreSQL local over Unix socket. Linux qlda maps to DB role qlda.
DATABASE_URL=postgresql:///qlda?host=/var/run/postgresql

# Local auth + file storage. vps/switch_to_local.sh creates the real secrets.
QLDA_STORAGE_BACKEND=local
QLDA_LOCAL_STORAGE_ROOT=/opt/qlda/data
QLDA_LOCAL_TRASH_ROOT=/opt/qlda/data/.trash
QLDA_PUBLIC_BASE_URL=https://qldaxd.id.vn
QLDA_LOCAL_UPLOAD_SECRET=REPLACE_WITH_RANDOM_64_HEX_OR_LONGER
QLDA_LOCAL_BOOTSTRAP_CODE=REPLACE_WITH_PRIVATE_BOOTSTRAP_CODE
QLDA_LOCAL_LEGACY_MAX_UPLOAD_MB=500
QLDA_LOCAL_DIRECT_MAX_UPLOAD_MB=500
QLDA_LOCAL_SESSION_TTL_HOURS=12
QLDA_LOCAL_FILE_HOST=127.0.0.1
QLDA_LOCAL_FILE_PORT=8502
QLDA_DRIVE_ENFORCE_RBAC=true

# V6.22 Admin System Settings
# Mutable settings saved by Admin are stored outside the Git checkout here.
QLDA_SETTINGS_DIR=/opt/qlda/shared/config
QLDA_SETTINGS_MASTER_KEY=
QLDA_ADMIN_STORAGE_ALLOWED_ROOT=/opt/qlda

# Optional fallback only. These are ignored while QLDA_STORAGE_BACKEND=local.
QLDA_DRIVE_WEBAPP_URL=
QLDA_DRIVE_API_TOKEN=

# Contractor Data Hub: Google Sheets + Google Drive, read-only.
# No Service Account is required. Contractors keep ownership and share their
# Sheet/folder to the Gmail account used by QLDA. OAuth is normally configured
# by Admin in Công cụ -> Hệ thống -> Google OAuth; the variables below are only
# backward-compatible bootstrap fallbacks.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://qldaxd.id.vn

# The dedicated worker checks every five minutes and each contractor warehouse
# decides whether it is due from its own 15-1440 minute synchronization interval.
QLDA_CONTRACTOR_DATA_SYNC_POLL_SECONDS=300

# AI - choose gemini or openai. These are bootstrap/default values. After Admin
# saves AI settings inside the app, V6.22 uses the encrypted Admin-managed copy.
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=auto
GEMINI_WEB_SEARCH=false

# Optional OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_WEB_SEARCH=false

# Optional Google Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Multicore Excel engine (BOQ / IPC / VO)
QLDA_CPU_WORKERS=3
QLDA_PARALLEL_EXCEL_MIN_MB=2
QLDA_PARALLEL_MIN_SHEETS=2
QLDA_MP_START_METHOD=forkserver
