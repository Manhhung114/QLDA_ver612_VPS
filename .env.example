# Copy to /opt/qlda/shared/qlda.env on the VPS.
# NEVER commit real credentials to GitHub.

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google Drive Apps Script Gateway
QLDA_DRIVE_WEBAPP_URL=https://script.google.com/macros/s/REPLACE_ME/exec
QLDA_DRIVE_API_TOKEN=REPLACE_ME

# AI - choose gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=auto
GEMINI_WEB_SEARCH=false

# Optional OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_WEB_SEARCH=false

# Optional Google Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Multicore Excel engine (BOQ / IPC / VO)
# On a 4-vCPU VPS the recommended child worker count is 3; the Streamlit
# process acts as the fourth worker for BOQ/VO or parses IPC while previews run.
QLDA_CPU_WORKERS=3
QLDA_PARALLEL_EXCEL_MIN_MB=2
QLDA_PARALLEL_MIN_SHEETS=2
QLDA_PARALLEL_JOBS=1
QLDA_MP_START_METHOD=forkserver
