# Copy to /opt/qlda/shared/qlda.env on the VPS.
# NEVER commit real credentials to GitHub.

# -----------------------------------------------------------------------------
# LIVE data on the VPS (recommended/default)
# -----------------------------------------------------------------------------
# PostgreSQL local over Unix socket. Linux service user qlda maps to DB role qlda.
DATABASE_URL=postgresql:///qlda?host=/var/run/postgresql

# Local auth + file storage. vps/switch_to_local.sh creates the real secrets.
QLDA_STORAGE_BACKEND=local
QLDA_LOCAL_STORAGE_ROOT=/opt/qlda/data
QLDA_LOCAL_TRASH_ROOT=/opt/qlda/data/.trash
QLDA_PUBLIC_BASE_URL=https://qldaxd.id.vn
QLDA_LOCAL_UPLOAD_SECRET=REPLACE_WITH_RANDOM_64_HEX_OR_LONGER
QLDA_LOCAL_BOOTSTRAP_CODE=REPLACE_WITH_PRIVATE_BOOTSTRAP_CODE
QLDA_LOCAL_LEGACY_MAX_UPLOAD_MB=200
QLDA_LOCAL_DIRECT_MAX_UPLOAD_MB=2048
QLDA_LOCAL_SESSION_TTL_HOURS=12
QLDA_LOCAL_FILE_HOST=127.0.0.1
QLDA_LOCAL_FILE_PORT=8502
QLDA_DRIVE_ENFORCE_RBAC=true

# Optional fallback only. These are ignored while QLDA_STORAGE_BACKEND=local.
QLDA_DRIVE_WEBAPP_URL=
QLDA_DRIVE_API_TOKEN=

# AI - choose gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=auto
GEMINI_WEB_SEARCH=false

# Optional OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_WEB_SEARCH=false

# Optional Google Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Multicore Excel engine (BOQ / IPC / VO)
# On a 4-vCPU VPS the recommended child worker count is 3; the Streamlit
# process acts as the fourth worker for BOQ/VO or parses IPC while previews run.
# Heavy multicore parses are serialized automatically to avoid CPU/RAM spikes
# when several users upload large Excel files at the same time.
QLDA_CPU_WORKERS=3
QLDA_PARALLEL_EXCEL_MIN_MB=2
QLDA_PARALLEL_MIN_SHEETS=2
QLDA_MP_START_METHOD=forkserver
