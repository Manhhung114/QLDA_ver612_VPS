# Copy to /opt/qlda/shared/qlda.env on the VPS.
# NEVER commit real credentials to GitHub.

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google Drive Apps Script Gateway
QLDA_DRIVE_WEBAPP_URL=https://script.google.com/macros/s/REPLACE_ME/exec
QLDA_DRIVE_API_TOKEN=REPLACE_ME

# AI - choose gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=auto
GEMINI_WEB_SEARCH=false

# Optional OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_WEB_SEARCH=false

# Optional Google Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
